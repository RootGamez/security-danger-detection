# ─────────────────────────────────────────────────────────────────────────────
# SecureVision Dashboard — configuración de entorno
#
# Copia este archivo a `.env` y ajusta la URL del backend.
#   cp .env.example .env
#
# El backend suele exponerse desde Colab con localtunnel/ngrok, por lo que la
# URL cambia en cada sesión. Puedes cambiarla de tres formas:
#
#   1. Editando `.env` y reiniciando `npm run dev`.
#   2. Sin reiniciar: desde el botón "Backend" en la barra superior del
#      dashboard (se guarda en localStorage y tiene prioridad sobre `.env`).
#   3. Por query string, útil para compartir un enlace ya configurado:
#      http://localhost:5173/?api=https://tu-tunel.loca.lt
# ─────────────────────────────────────────────────────────────────────────────

# URL base del backend de visión (sin barra final).
# Ejemplos:
#   VITE_API_BASE_URL=http://localhost:8000
#   VITE_API_BASE_URL=https://wicked-horses-leave.loca.lt
#   VITE_API_BASE_URL=https://abcd-34-125-1-2.ngrok-free.app
VITE_API_BASE_URL=http://localhost:8000

# Nombre mostrado en la cabecera del dashboard.
VITE_APP_NAME=SecureVision

# Timeout (ms) de la comprobación de salud contra GET /health.
VITE_HEALTH_TIMEOUT_MS=6000

# Umbral de confianza por defecto (0.05 – 0.95) enviado al backend.
VITE_DEFAULT_CONFIDENCE=0.35
